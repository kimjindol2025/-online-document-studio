      "options": [
        "10%",
        "0%"
      ],
      "default": "10%",
      "hint": "품목별 원 단위 미만 버림. 0% 선택 시 세액을 더하지 않습니다."
    },
    {
      "id": "items",
      "label": "품목",
      "group": "품목·금액",
      "type": "repeater",
      "required": true,
      "columns": [
        {
          "id": "description",
          "label": "품목 / 규격",
          "required": true
        },
        {
          "id": "quantity",
          "label": "수량",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 1000000,
          "integer": true
        },
        {
          "id": "unitPrice",
          "label": "단가 (원)",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 999999999999,
          "integer": true
        }
      ],
      "initialRows": 1,
      "hint": "수량 × 단가와 합계를 자동 계산합니다. 수량·단가는 정수로 입력하세요."
    },
    {
      "id": "notes",
      "label": "특기사항",
      "group": "기타",
